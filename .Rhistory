# ==============================================================================
# VALIDATION: EMPTY RESULTS (Blue/Info Style)
# ==============================================================================
check_empty_results_mego <- function(results, session) {
# Comprueba si es NULL o un data.frame con 0 filas
is_empty <- is.null(results) || (is.data.frame(results) && nrow(results) == 0)
if (is_empty) {
showModal(modalDialog(
title = tags$div(icon("search-minus"), " No Enrichment Results Found",
style = "text-align: center; font-weight: bold; font-size: 20px; color: #2980b9;"),
easyClose = TRUE,
size = "l",
# Alert Box (Azul claro)
tags$div(
class = "alert alert-info", role = "alert",
tags$h4(icon("info-circle"), " Analysis Completed successfully, but..."),
tags$p("No biological terms (pathways/functions) were found to be statistically significant based on your gene list.")
),
# Suggestions Panel (Gris con borde azul)
tags$div(
style = "background-color: #f8f9fa; padding: 15px; border-radius: 5px; border-left: 5px solid #2980b9; margin-top: 15px;",
tags$h5("Troubleshooting Guide:", style = "margin-top:0; font-weight:bold;"),
fluidRow(
column(6,
tags$h6(tags$b("1. Check Identifiers")),
tags$p("Did you select the correct ID type?"),
tags$ul(
tags$li("Human SYMBOL: ", tags$code("BRCA1")),
tags$li("Mouse SYMBOL: ", tags$code("Brca1")),
tags$li("Ensembl: ", tags$code("ENSG000..."))
)
),
column(6,
tags$h6(tags$b("2. Check Input Size")),
tags$p("Small gene lists (< 10 genes) often lack statistical power to find enrichment."),
tags$p("Try relaxing filters or using a larger list.")
)
)
),
tags$div(style = "margin-top: 15px; text-align: center; font-style: italic; color: #777;",
"If you believe this is an error, try running the Example Data to confirm the tool is working."),
footer = modalButton("Close")
))
return(FALSE) # Devuelve FALSE para detener el proceso
}
return(TRUE) # Devuelve TRUE para continuar
}
runApp('Escritorio/tfm/MetaOmixTools')
View(check_empty_results_mego)
View(check_empty_results)
View(check_empty_results_mego)
View(check_empty_results)
