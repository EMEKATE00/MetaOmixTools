setwd("C:/Users/maksy/Desktop/tfm/MetaRank/example_data")
# Lista de archivos
archivos <- c("gene1.txt", "gene2.txt", "gene3.txt", "gene4.txt")
# Procesar cada archivo
for (archivo in archivos) {
# Leer contenido
contenido <- readLines(archivo, warn = FALSE)
# Convertir a mayúsculas
contenido_mayus <- toupper(contenido)
# Sobrescribir el archivo
writeLines(contenido_mayus, archivo)
}
runApp('C:/Users/maksy/Desktop/tfm/MetaRank/app_v2.R')
